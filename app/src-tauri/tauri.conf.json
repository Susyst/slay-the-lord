{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Slay the Lord",
  "version": "1.4.0",
  "identifier": "com.aarnav.slaythelord",
  "build": {
    "frontendDist": "../../game",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "windows": [
      {
        "title": "Pokemon? Slay the Lord",
        "width": 720,
        "height": 480,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "A GBA-style creature RPG."
  }
}